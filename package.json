{
  "name": "forest-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.21.0",
    "pnpm": "10.10.0"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "vite",
    "copy:shared": "rm -rf supabase/functions/shared && cp -r src/shared supabase/functions/shared",
    "deploy:functions": "pnpm copy:shared && pnpm dlx supabase functions deploy game-create && pnpm dlx supabase functions deploy game-join && pnpm dlx supabase functions deploy game-action && pnpm dlx supabase functions deploy game-state",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.client.json",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "knip": "^5.66.2",
    "oxlint": "^1.22.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1"
  }
}
