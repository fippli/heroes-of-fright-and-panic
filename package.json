{
  "name": "forest-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "copy:shared": "rm -rf supabase/functions/shared && cp -r src/shared supabase/functions/shared",
    "deploy:functions": "pnpm copy:shared && pnpm dlx supabase functions deploy game-create && pnpm dlx supabase functions deploy game-join && pnpm dlx supabase functions deploy game-action && pnpm dlx supabase functions deploy game-state",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "cli": "npx tsx --tsconfig tsconfig.base.json src/cli/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "knip": "^5.85.0",
    "oxlint": "^1.49.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "marked": "^17.0.5",
    "mermaid": "^11.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  }
}
