{
  "name": "forest-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.21.0",
    "pnpm": ">=10.10.0"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev:server": "tsx watch src/api/index.ts",
    "dev:client": "vite build --watch",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/api/index.js",
    "preview": "vite preview",
    "lint": "oxlint ./src",
    "fmt": "prettier --write ./src",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "knip": "^5.66.2",
    "oxlint": "^1.22.0",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
