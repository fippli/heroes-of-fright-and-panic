{
  "name": "forest-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "scripts": {
    "dev": "vite",
    "copy:shared": "rm -rf supabase/functions/shared && cp -r src/shared supabase/functions/shared",
    "deploy:functions": "pnpm copy:shared && pnpm dlx supabase functions deploy game-create && pnpm dlx supabase functions deploy game-join && pnpm dlx supabase functions deploy game-action && pnpm dlx supabase functions deploy game-state",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "cli": "npx tsx --tsconfig tsconfig.base.json src/cli/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "knip": "^5.85.0",
    "oxlint": "^1.49.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  }
}
