// tsconfig.server.json
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/server",
    "outDir": "dist/server",
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/server", "src/shared"]
}
